# Copy this file to .env and fill in your real values.
# Keep secrets out of the repository.

# --- Core app ---
PORT=8000
APP_ENV=development

# --- Authentication / JWT ---
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_TOKEN_EXPIRE_MINUTES=120

# --- Database ---
DB_PATH=app/data/university.db
DATA_FOLDER_PATH=app/data
MONGO_URI=

# --- Groq / LLM ---
Groq_api_key=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ROUTER_TEMPERATURE=0.1
AGENT_TEMPERATURE=0.2
FINAL_TEMPERATURE=0.3

# --- Langfuse observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Speech / ASR ---
ASR_MODEL_NAME=jonatasgrosman/wav2vec2-large-xlsr-53-arabic

# --- Sentiment model paths ---
# These are optional if you run the project in the same machine setup used by the original developer.
SENTIMENT_MODEL_PATH=/home/azure/Kayfa/kayfa-agentic-lms/app/services/sentiment_model_glove.keras
TOKENIZER_PATH=/home/azure/Kayfa/kayfa-agentic-lms/app/services/tokenizer.pkl

# --- Optional extras ---
# Some integrations may not be used in this project but are kept for compatibility.
